---
interface Stage {
  number: string;
  title: string;
  text: string;
  image: string;
  alt: string;
}

const stages: Stage[] = [
  {
    number: "01",
    title: "Origen y Selección de Semilla",
    text: "Evaluamos y seleccionamos variedades nativas de cacao de los Andes y la Amazonía, priorizando calidad genética y aptitud para el cultivo orgánico.",
    image: "/images/viaje/01-seleccion-semilla.jpg",
    alt: "Agricultor examinando semillas de cacao seleccionadas",
  },
  {
    number: "02",
    title: "Siembra",
    text: "La semilla seleccionada se siembra en microclimas específicos, trabajando mano a mano con agricultores capacitados en prácticas orgánicas.",
    image: "/images/viaje/02-siembra.jpg",
    alt: "Agricultor sembrando cacao en almácigo",
  },
  {
    number: "03",
    title: "Germinación y Primeros Brotes",
    text: "Monitoreamos las condiciones climáticas —sol, lluvia y temperatura— que acompañan la germinación, hasta la aparición de los primeros brotes.",
    image: "/images/viaje/03-germinacion.jpg",
    alt: "Brote de cacao emergiendo de la tierra",
  },
  {
    number: "04",
    title: "Crecimiento y Desarrollo",
    text: "Durante el desarrollo de la planta aplicamos cuidados agronómicos —riego, control de plagas y nutrición del suelo— para un crecimiento saludable.",
    image: "/images/viaje/04-crecimiento.jpg",
    alt: "Planta joven de cacao en desarrollo",
  },
  {
    number: "05",
    title: "Maduración",
    text: "Verificamos que la mazorca haya alcanzado el punto óptimo de maduración —color y firmeza— antes de autorizar la cosecha.",
    image: "/images/viaje/05-maduracion.jpg",
    alt: "Mazorcas de cacao maduras colgando del árbol",
  },
  {
    number: "06",
    title: "Cosecha y Acopio",
    text: "La cosecha se realiza manualmente en el punto óptimo de maduración. Cada lote se etiqueta de inmediato en campo con un código único.",
    image: "/images/viaje/06-cosecha-acopio.jpg",
    alt: "Trabajador cosechando mazorcas de cacao",
  },
  {
    number: "07",
    title: "Procesamiento y Calidad",
    text: "En planta certificada, el grano pasa por fermentación, secado y estrictos análisis físico-químicos y microbiológicos antes de ser liberado.",
    image: "/images/viaje/07-procesamiento-calidad.jpg",
    alt: "Técnico de laboratorio analizando granos de cacao",
  },
  {
    number: "08",
    title: "Empaque y Exportación Segura",
    text: "El producto final se embala bajo estándares internacionales y se consolida para su exportación, con documentación completa de origen y calidad.",
    image: "/images/viaje/08-empaque-exportacion.jpg",
    alt: "Sacos de cacao embalados listos para exportación",
  },
];
---

<section class="viaje" id="viaje-de-la-calidad">
  <header class="viaje-header">
    <h2 class="viaje-title">El Viaje de la <span>Calidad</span></h2>
    <p class="viaje-subtitle">
      Un recorrido riguroso diseñado para preservar la pureza de origen en cada eslabón de la cadena.
    </p>
  </header>

  <div class="viaje-timeline">
    {stages.map((stage, i) => (
      <article class="viaje-stage">
        <div class="viaje-node">
          <span>{stage.number}</span>
        </div>

        <div class="viaje-content">
          <p class="viaje-step-label">Paso {stage.number} <span>/ 08</span></p>
          <h3 class="viaje-step-title">{stage.title}</h3>
          <p class="viaje-step-text">{stage.text}</p>
        </div>

        <div class="viaje-media">
          <img
            src={stage.image}
            alt={stage.alt}
            loading={i === 0 ? "eager" : "lazy"}
            onerror="this.parentElement.style.background='linear-gradient(135deg, #e8e0d4, #c4a77d)'; this.style.display='none'; this.nextElementSibling.style.display='flex';"
          />
          <span class="viaje-fallback-text">{stage.image.split("/").pop()}</span>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .viaje {
    background: #fafaf7;
    color: #1c1c1a;
    font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
    padding-bottom: 6rem;
  }

  .viaje-header {
    max-width: 640px;
    margin: 0 auto;
    padding: 5rem 1.5rem 3rem;
    text-align: center;
  }

  .viaje-title {
    font-size: clamp(2.2rem, 5.5vw, 3.2rem);
    font-weight: 800;
    margin: 0 0 1rem;
    letter-spacing: -0.03em;
  }

  .viaje-title span {
    color: #1e5631;
    position: relative;
  }

  .viaje-title span::after {
    content: '';
    position: absolute;
    bottom: 2px;
    left: -6px;
    right: -6px;
    height: 14px;
    background: linear-gradient(90deg, rgba(30,86,49,0.14), rgba(30,86,49,0.04));
    border-radius: 4px;
    z-index: -1;
  }

  .viaje-subtitle {
    font-size: 1.15rem;
    line-height: 1.7;
    color: #6b6b65;
    margin: 0 auto;
    max-width: 520px;
  }

  /* ============================================================
     TIMELINE VERTICAL CON LÍNEA CENTRAL
     ============================================================ */
  .viaje-timeline {
    position: relative;
    max-width: 1000px;
    margin: 0 auto;
    padding: 2rem 0;
  }

  /* Línea vertical central segmentada */
  .viaje-timeline::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 3px;
    transform: translateX(-50%);
    background: repeating-linear-gradient(
      to bottom,
      #c4a77d 0px,
      #c4a77d 12px,
      transparent 12px,
      transparent 24px
    );
    z-index: 0;
  }

  /* ============================================================
     ETAPAS
     ============================================================ */
  .viaje-stage {
    position: relative;
    display: flex;
    align-items: center;
    margin-bottom: 5rem;
    min-height: 280px;
  }

  .viaje-stage:nth-child(odd)  { flex-direction: row; }
  .viaje-stage:nth-child(even) { flex-direction: row-reverse; }

  /* ---- Nodo circular ---- */
  .viaje-node {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: linear-gradient(145deg, #ffffff, #e8e0d4);
    border: 3px solid #8b6914;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow:
      0 0 0 10px rgba(250,250,247,0.9),
      0 8px 28px rgba(139,105,20,0.2),
      inset 0 2px 4px rgba(255,255,255,0.6);
    font-size: 0.85rem;
    font-weight: 800;
    color: #6b4e2e;
  }

  /* ---- Tarjeta de contenido ---- */
  .viaje-content {
    width: 38%;
    padding: 2rem 2.25rem;
    background: #ffffff;
    border: 1px solid rgba(0,0,0,0.06);
    border-radius: 20px;
    box-shadow:
      0 2px 8px rgba(0,0,0,0.04),
      0 12px 36px rgba(0,0,0,0.06);
    position: relative;
    z-index: 2;
  }

  .viaje-content::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, #8b6914, #c4a77d, #8b6914);
    border-radius: 20px 20px 0 0;
    opacity: 0.6;
  }

  .viaje-step-label {
    font-size: 0.72rem;
    font-weight: 700;
    color: #8b6914;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin: 0 0 0.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .viaje-step-label::before {
    content: '';
    width: 22px;
    height: 2px;
    background: #8b6914;
    opacity: 0.35;
    border-radius: 1px;
  }

  .viaje-stage:nth-child(odd) .viaje-step-label { flex-direction: row-reverse; }

  .viaje-step-label span {
    color: rgba(0,0,0,0.25);
    font-weight: 500;
  }

  .viaje-step-title {
    font-size: clamp(1.25rem, 2.4vw, 1.55rem);
    font-weight: 700;
    margin: 0 0 0.9rem;
    color: #1c1c1a;
    line-height: 1.25;
  }

  .viaje-step-text {
    font-size: 0.96rem;
    line-height: 1.8;
    color: #5a5a54;
    margin: 0;
  }

  /* ---- Imagen ---- */
  .viaje-media {
    width: 38%;
    aspect-ratio: 4 / 3;
    border-radius: 18px;
    overflow: hidden;
    background: linear-gradient(135deg, #e8e0d4, #d4c4a8);
    box-shadow:
      0 6px 20px rgba(0,0,0,0.08),
      0 24px 60px rgba(0,0,0,0.12);
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .viaje-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .viaje-fallback-text {
    display: none;
    font-size: 0.8rem;
    font-weight: 600;
    color: #8b6914;
    text-align: center;
    padding: 1rem;
  }

  .viaje-stage:nth-child(odd) .viaje-media  { margin-left: auto; margin-right: 0; }
  .viaje-stage:nth-child(even) .viaje-media { margin-right: auto; margin-left: 0; }

  /* ============================================================
     RESPONSIVE
     ============================================================ */
  @media (max-width: 1024px) {
    .viaje-timeline::before { display: none; }

    .viaje-stage,
    .viaje-stage:nth-child(odd),
    .viaje-stage:nth-child(even) {
      flex-direction: column;
      gap: 1.5rem;
      margin-bottom: 4rem;
      min-height: auto;
    }

    .viaje-content {
      width: 85%;
      max-width: 540px;
      text-align: center;
      margin: 0 auto;
    }

    .viaje-step-label { justify-content: center; }

    .viaje-media {
      width: 85%;
      max-width: 540px;
      margin: 0 auto !important;
    }

    .viaje-node {
      position: relative;
      left: auto;
      top: auto;
      transform: none;
      margin: 0 auto;
    }
  }

  @media (max-width: 640px) {
    .viaje-content,
    .viaje-media {
      width: 100%;
    }

    .viaje-node {
      width: 52px;
      height: 52px;
    }
  }
</style>
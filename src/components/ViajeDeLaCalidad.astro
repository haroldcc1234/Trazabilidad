      <path class="viaje-path-soil"  d="M 450,30  C 450,90  220,130  220,200  C 220,270  680,310  680,380  C 680,450  180,490  180,560  C 180,630  720,670  720,740  C 720,810  200,850  200,920  C 200,990  680,1030 680,1100 C 680,1170 220,1210 220,1280 C 220,1350 700,1390 700,1460 C 700,1530 200,1570 200,1640 C 200,1710 650,1750 650,1820 C 650,1890 250,1930 250,2000 C 250,2070 600,2110 600,2180 C 600,2250 450,2290 450,2350 C 450,2380 450,2390 450,2395" />
